PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:123@localhost:5432/geozone_db?schema=public"

# Auth / Dual-Token Security (Chuẩn Cryptographic 256-bit Hex của Velora)
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# AI Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-2.5-flash"

# Feature Flag for AI Generation Strategy: "DIRECT_JSON" (Phương án không RAG) | "RAG_AUGMENTED" (Phương án có RAG)
AI_STRATEGY="DIRECT_JSON"
ENABLE_RAG=false
