PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geozone_db?schema=public"

# AI Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-2.5-flash"

# Feature Flag for AI Generation Strategy: "DIRECT_JSON" (Phương án không RAG) | "RAG_AUGMENTED" (Phương án có RAG)
AI_STRATEGY="DIRECT_JSON"
ENABLE_RAG=false
