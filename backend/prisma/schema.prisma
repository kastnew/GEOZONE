datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  ADMIN
  USER
  CUSTOMER

  @@map("user_role")
}

enum PlanStatus {
  DRAFT
  VALIDATING
  COMPLETED
  FAILED

  @@map("plan_status")
}

// ==========================================
// 2. AUTHENTICATION & USERS (VELORA PATTERN)
// ==========================================

model User {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String         @unique @db.VarChar(255)
  name               String?        @db.VarChar(120)
  password_hash      String         @db.VarChar(255)
  role               Role           @default(USER)
  is_active          Boolean        @default(true)
  is_verified        Boolean        @default(false)
  avatar_url         String?        @db.VarChar(255)
  verification_token String?        @db.VarChar(255)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  refresh_tokens     RefreshToken[]
  saved_plans        SavedPlan[]
  favorites          UserFavorite[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([token_hash], map: "idx_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

// ==========================================
// 3. SAVED ITINERARIES & FAVORITES
// ==========================================

model SavedPlan {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String      @db.Uuid
  title         String      @db.VarChar(255)
  city          String      @default("Da Nang") @db.VarChar(100)
  total_days    Int
  total_budget  Decimal     @db.Decimal(12, 2)
  actual_cost   Decimal     @db.Decimal(12, 2)
  status        PlanStatus  @default(DRAFT)
  strategy_used String      @default("DIRECT_JSON") @db.VarChar(50)
  plan_data     Json        @db.JsonB
  share_token   String?     @unique @db.VarChar(100)
  is_public     Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_saved_plans_user_id")
  @@index([share_token], map: "idx_saved_plans_share_token")
  @@map("saved_plans")
}

model UserFavorite {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  place_id   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  place      Place    @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@unique([user_id, place_id], map: "unique_user_favorite_place")
  @@index([user_id], map: "idx_user_favorites_user_id")
  @@map("user_favorites")
}

// ==========================================
// 4. GEOGRAPHIC ZONES & DISTANCES
// ==========================================

model Zone {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(20)
  name          String         @db.VarChar(150)
  description   String?        @db.Text
  centerLat     Decimal?       @map("center_lat") @db.Decimal(10, 7)
  centerLng     Decimal?       @map("center_lng") @db.Decimal(10, 7)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  places        Place[]
  distancesFrom ZoneDistance[] @relation("FromZone")
  distancesTo   ZoneDistance[] @relation("ToZone")

  @@map("zones")
}

model ZoneDistance {
  id                 Int      @id @default(autoincrement())
  fromZoneId         Int      @map("from_zone_id")
  toZoneId           Int      @map("to_zone_id")
  estimatedTravelMin Int      @default(15) @map("estimated_travel_min")
  distanceKm         Decimal? @map("distance_km") @db.Decimal(10, 2)

  fromZone           Zone     @relation("FromZone", fields: [fromZoneId], references: [id])
  toZone             Zone     @relation("ToZone", fields: [toZoneId], references: [id])

  @@unique([fromZoneId, toZoneId], map: "unique_zone_distance_pair")
  @@map("zone_distances")
}

// ==========================================
// 5. PLACES & TAXONOMY (TAGS)
// ==========================================

model Place {
  id            Int              @id @default(autoincrement())
  name          String           @db.VarChar(255)
  city          String           @default("Da Nang") @db.VarChar(100)
  zoneId        Int              @map("zone_id")
  address       String?          @db.VarChar(255)
  estimatedCost Decimal          @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  duration      Int              @default(60)
  openingTime   DateTime?        @map("opening_time") @db.Time
  closingTime   DateTime?        @map("closing_time") @db.Time
  latitude      Decimal?         @db.Decimal(10, 7)
  longitude     Decimal?         @db.Decimal(10, 7)
  popularity    Decimal          @default(0.5) @db.Decimal(3, 2)
  imageUrl      String?          @map("image_url") @db.VarChar(255)
  rating        Decimal?         @default(4.5) @db.Decimal(2, 1)
  shortDesc     String?          @map("short_desc") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone          Zone             @relation(fields: [zoneId], references: [id])
  placeTags     PlaceTag[]
  knowledgeDocs KnowledgeChunk[]
  favorites     UserFavorite[]

  @@index([zoneId], map: "idx_places_zone_id")
  @@index([city], map: "idx_places_city")
  @@map("places")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  category  String?    @db.VarChar(100)
  places    PlaceTag[]

  @@map("tags")
}

model PlaceTag {
  placeId   Int   @map("place_id")
  tagId     Int   @map("tag_id")

  place     Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag       Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
  @@index([tagId], map: "idx_place_tags_tag_id")
  @@map("place_tags")
}

// ==========================================
// 6. RAG KNOWLEDGE BASE
// ==========================================

model KnowledgeChunk {
  id          Int      @id @default(autoincrement())
  placeId     Int?     @map("place_id")
  title       String   @db.VarChar(255)
  content     String   @db.Text
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  place       Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([placeId], map: "idx_knowledge_chunks_place_id")
  @@map("knowledge_chunks")
}
